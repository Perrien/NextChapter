{
  "name": "the-next-chapter",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "python3 scripts/build.py",
    "setup:access": "python3 scripts/setup_access.py",
    "preview:setup": "python3 scripts/build.py --setup-preview",
    "update:data": "python3 scripts/update_data.py",
    "dev": "python3 -m http.server 4174 --bind 127.0.0.1 --directory dist",
    "test": "node --test tests/*.test.mjs && python3 -m unittest discover -s tests -p 'test_*.py'",
    "verify:local": "node scripts/verify_local.mjs",
    "verify:public": "node scripts/verify_public.mjs",
    "verify:artifact": "node scripts/verify_public.mjs --artifact"
  },
  "devDependencies": {
    "staticrypt": "3.5.4"
  }
}
